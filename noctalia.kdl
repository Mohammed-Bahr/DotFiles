layout {

    focus-ring {
        active-color "#98971a"
        inactive-color "#fbf1c7"
        urgent-color "#cc241d"
    }

    border {
        active-color "#98971a"
        inactive-color "#fbf1c7"
        urgent-color "#cc241d"

        width 1
    }


    tab-indicator {
        active-color "#98971a"
        inactive-color "#d9d98b"
        urgent-color "#cc241d"
    }

    insert-hint {
        color "#98971a80"
    }
    shadow {
    }
}

recent-windows {
    highlight {
        active-color "#98971a"
        urgent-color "#cc241d"
    }
}
